# Kopiere diese Datei nach ".env.local" und trage deine Werte aus Supabase ein
# (Supabase → Project Settings → API Keys). NUR den publishable/anon Key verwenden,
# NIEMALS den secret/service_role Key!
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxx
# Öffentlicher VAPID-Schlüssel für Push-Benachrichtigungen (der private liegt nur in den Supabase-Secrets)
VITE_VAPID_PUBLIC_KEY=
